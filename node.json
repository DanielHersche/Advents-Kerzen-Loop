{
    "name": "Kerzen Loop Player",
    "options": [
        {
            "title": "Playlist",
            "name": "playlist",
            "type": "list",
            "itemname": "Film",
            "items": [
                {
                    "title": "Film",
                    "name": "file",
                    "type": "resource",
                    "valid": [
                        "video",
                        "image"
                    ],
                    "default": "empty.png",
                    "features": [
                        "h264",
                        "hevc",
                        "image2k"
                    ]
                },
                {
                    "title": "Dauer (Sekunden)",
                    "name": "duration",
                    "type": "duration",
                    "default": 60
                }
            ]
        },
        {
            "title": "Ueberblendung (Sekunden, 0 = harter Schnitt)",
            "name": "fade",
            "type": "float",
            "default": 1.0
        },
        {
            "title": "Bildschirm-Drehung",
            "name": "rotation",
            "type": "select",
            "options": [
                [
                    0,
                    "0 Grad (keine)"
                ],
                [
                    90,
                    "90 Grad"
                ],
                [
                    180,
                    "180 Grad"
                ],
                [
                    270,
                    "270 Grad"
                ]
            ],
            "default": 0
        },
        {
            "title": "Zeitplan aktiv (Bildschirm nachts ausschalten)",
            "name": "schedule_enabled",
            "type": "boolean",
            "default": true
        },
        {
            "title": "Ausschalten um (HH:MM)",
            "name": "off_time",
            "type": "string",
            "default": "22:30"
        },
        {
            "title": "Einschalten um (HH:MM)",
            "name": "on_time",
            "type": "string",
            "default": "07:30"
        }
    ]
}